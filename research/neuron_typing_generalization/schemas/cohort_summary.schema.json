{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Natural-cohort response-state occupancy row",
  "type": "object",
  "required": [
    "run_id", "cohort_field", "cohort", "layer", "sample_count", "valid_observations",
    "count_W", "count_V", "count_T", "count_M",
    "proportion_W", "proportion_V", "proportion_T", "proportion_M"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "cohort_field": {"type": "string"},
    "cohort": {"type": "string"},
    "layer": {"type": ["integer", "null"], "minimum": 0},
    "sample_count": {"type": "integer", "minimum": 1},
    "valid_observations": {"type": "integer", "minimum": 0},
    "count_W": {"type": "integer", "minimum": 0},
    "count_V": {"type": "integer", "minimum": 0},
    "count_T": {"type": "integer", "minimum": 0},
    "count_M": {"type": "integer", "minimum": 0},
    "proportion_W": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "proportion_V": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "proportion_T": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "proportion_M": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
