{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reduced activation collection manifest",
  "type": "object",
  "required": [
    "run_id", "samples", "layers", "d_ff", "d_ff_by_layer", "rows", "storage_format",
    "raw_token_activations_retained"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "samples": {"type": "integer", "minimum": 1},
    "layers": {"type": "integer", "minimum": 1},
    "d_ff": {"type": "integer", "minimum": 1},
    "d_ff_by_layer": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "rows": {"type": "integer", "minimum": 1},
    "storage_format": {"enum": ["legacy_parquet_v1", "partitioned_npz_v1"]},
    "statistics_file": {"type": "string", "minLength": 1},
    "statistics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statistics_directory": {"type": "string", "minLength": 1},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sample_index", "sample_id", "file", "sha256"],
        "properties": {
          "sample_index": {"type": "integer", "minimum": 0},
          "sample_id": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "parts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "down_projection_norms_file": {"type": "string", "minLength": 1},
    "down_projection_norms_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resumed_samples": {"type": "integer", "minimum": 0},
    "raw_token_activations_retained": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"storage_format": {"const": "legacy_parquet_v1"}}},
      "then": {"required": ["statistics_file", "statistics_sha256"]}
    },
    {
      "if": {"properties": {"storage_format": {"const": "partitioned_npz_v1"}}},
      "then": {
        "required": [
          "statistics_directory", "parts", "parts_sha256", "down_projection_norms_file",
          "down_projection_norms_sha256", "resumed_samples"
        ]
      }
    }
  ],
  "additionalProperties": false
}
