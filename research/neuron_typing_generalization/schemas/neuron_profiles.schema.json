{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-sample neuron stability profile row",
  "type": "object",
  "required": [
    "run_id", "layer", "neuron", "d_ff", "valid_samples", "invalid_samples",
    "count_W", "count_V", "count_T", "count_M",
    "proportion_W", "proportion_V", "proportion_T", "proportion_M", "entropy", "normalized_entropy",
    "changed_ordered_pairs", "valid_ordered_pairs_including_self", "change_rate_including_self",
    "valid_distinct_ordered_pairs", "change_rate_distinct_pairs", "dominant_class", "dominant_proportion",
    "effective_class_count", "profile",
    "q_visual_valid_samples", "q_visual_mean", "q_visual_std", "q_visual_min", "q_visual_max",
    "q_text_valid_samples", "q_text_mean", "q_text_std", "q_text_min", "q_text_max",
    "visual_margin_mean", "text_margin_mean"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "layer": {"type": "integer", "minimum": 0},
    "neuron": {"type": "integer", "minimum": 0},
    "d_ff": {"type": "integer", "minimum": 1},
    "valid_samples": {"type": "integer", "minimum": 0},
    "invalid_samples": {"type": "integer", "minimum": 0},
    "count_W": {"type": "integer", "minimum": 0},
    "count_V": {"type": "integer", "minimum": 0},
    "count_T": {"type": "integer", "minimum": 0},
    "count_M": {"type": "integer", "minimum": 0},
    "proportion_W": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "proportion_V": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "proportion_T": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "proportion_M": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "changed_ordered_pairs": {"type": "integer", "minimum": 0},
    "valid_ordered_pairs_including_self": {"type": "integer", "minimum": 0},
    "change_rate_including_self": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "valid_distinct_ordered_pairs": {"type": "integer", "minimum": 0},
    "change_rate_distinct_pairs": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "entropy": {"type": ["number", "null"], "minimum": 0},
    "normalized_entropy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "dominant_class": {"enum": ["V", "T", "M", "W", "INVALID"]},
    "dominant_proportion": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "effective_class_count": {"type": ["number", "null"], "minimum": 1, "maximum": 4},
    "q_visual_valid_samples": {"type": "integer", "minimum": 0},
    "q_visual_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "q_visual_std": {"type": ["number", "null"], "minimum": 0},
    "q_visual_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "q_visual_max": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "q_text_valid_samples": {"type": "integer", "minimum": 0},
    "q_text_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "q_text_std": {"type": ["number", "null"], "minimum": 0},
    "q_text_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "q_text_max": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "visual_margin_mean": {"type": ["number", "null"]},
    "text_margin_mean": {"type": ["number", "null"]},
    "profile": {"type": "string"}
  },
  "additionalProperties": false
}
